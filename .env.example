# Copy to backend/.env and adjust. Never commit real secrets.

# --- Core -------------------------------------------------------------
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First-run administrator (created only when the users table is empty)
SEED_ADMIN_EMAIL=admin@evidencex.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# --- Database -----------------------------------------------------------
# Local default: SQLite file in backend/data/. Docker stack: PostgreSQL (pgvector image).
# DATABASE_URL=sqlite:///./data/evidencex.db
# DATABASE_URL=postgresql+psycopg://evidencex:evidencex@localhost:5432/evidencex

# --- Evidence storage ---------------------------------------------------
STORAGE_BACKEND=local            # local | s3
# STORAGE_ROOT=./data/storage
# S3 / MinIO
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=evidencex
# S3_SECRET_KEY=evidencex-secret
# S3_BUCKET=evidencex
# Optional at-rest encryption for local storage (Fernet key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STORAGE_ENCRYPTION_KEY=

MAX_UPLOAD_MB=100
RETENTION_DAYS=0                 # 0 = keep indefinitely; applies to archived cases without legal hold

# --- Graph --------------------------------------------------------------
GRAPH_BACKEND=networkx           # networkx (in-process). neo4j settings reserved for the mirror.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=evidencex-neo4j

# --- LLM (optional) -----------------------------------------------------
# Without a key the engine runs fully deterministic and the UI says so.
LLM_PROVIDER=anthropic           # anthropic | none
ANTHROPIC_API_KEY=
LLM_MODEL=            # model ID from your LLM provider (required to enable AI augmentation)

# --- Extraction engines -------------------------------------------------
OCR_ENGINE=auto                  # auto | rapidocr | paddleocr | none
ASR_ENGINE=auto                  # auto | faster-whisper | none
WHISPER_MODEL=base               # tiny | base | small | medium
NLP_ENGINE=auto                  # auto | spacy | none
